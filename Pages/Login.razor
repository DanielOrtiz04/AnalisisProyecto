@page "/login"
@using ReservaCancha.Services
@inject HttpClient Http
@inject NavigationManager NavManager
@inject SesionService Sesion

<PageTitle>Iniciar sesión | ReservaCancha</PageTitle>

<div class="lg-wrap">
    <div class="lg-card">
        <div class="lg-logo">⚽</div>
        <h1 class="lg-title">Iniciar sesión</h1>
        <p class="lg-sub">Bienvenido de vuelta</p>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="lg-alert lg-alert--error">@error</div>
        }

        <div class="lg-field">
            <label>Correo</label>
            <input type="email" class="lg-input" placeholder="correo@ejemplo.com"
                   @bind="correo" @bind:event="oninput" />
        </div>

        <div class="lg-field">
            <label>Contraseña</label>
            <input type="password" class="lg-input" placeholder="Tu contraseña"
                   @bind="password" @bind:event="oninput"
                   @onkeydown="OnKeyDown" />
        </div>

        <button class="lg-btn" @onclick="IniciarSesion" disabled="@cargando">
            @if (cargando) { <span class="lg-spinner"></span> }
            else { <span>Entrar</span> }
        </button>

        <p class="lg-foot">¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
    </div>
</div>

@code {
    private string correo   = string.Empty;
    private string password = string.Empty;
    private string? error;
    private bool cargando = false;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await IniciarSesion();
    }

    private async Task IniciarSesion()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(correo) || string.IsNullOrWhiteSpace(password))
        {
            error = "Ingresa tu correo y contraseña.";
            return;
        }

        cargando = true;
        try
        {
            var resp = await Http.PostAsJsonAsync("http://localhost:5085/api/usuarios/login",
                new { Correo = correo, Password = password });

            if (resp.IsSuccessStatusCode)
            {
                var r = await resp.Content.ReadFromJsonAsync<LoginResp>();
                if (r?.Datos == null || r.Datos.UsuarioId == 0)
                {
                    error = "Error al procesar la respuesta del servidor.";
                    return;
                }
                Sesion.IniciarSesion(r.Datos.UsuarioId, r.Datos.Nombre, correo.Trim().ToLower());
                NavManager.NavigateTo($"/perfil/{r.Datos.UsuarioId}");
            }
            else
            {
                var e2 = await resp.Content.ReadFromJsonAsync<ErrResp>();
                error = e2?.Mensaje ?? "Correo o contraseña incorrectos.";
            }
        }
        catch { error = "No se pudo conectar al servidor."; }
        finally { cargando = false; }
    }

    class LoginResp
    {
        public string Mensaje { get; set; } = string.Empty;
        public DatosLogin? Datos { get; set; }
    }

    class DatosLogin
    {
        public int    UsuarioId { get; set; }
        public string Nombre    { get; set; } = string.Empty;
    }

    record ErrResp(string Mensaje);
}

<style>
    .lg-wrap  { min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 1rem; }
    .lg-card  { background: #fff; border: 1px solid rgba(0,0,0,.1); border-radius: 16px; padding: 2rem; width: 100%; max-width: 380px; box-shadow: 0 4px 24px rgba(0,0,0,.07); }
    .lg-logo  { font-size: 2.5rem; text-align: center; margin-bottom: .5rem; }
    .lg-title { font-size: 1.4rem; font-weight: 700; text-align: center; margin: 0 0 4px; }
    .lg-sub   { font-size: .85rem; color: #888; text-align: center; margin: 0 0 1.5rem; }
    .lg-alert { padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 1rem; }
    .lg-alert--error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    .lg-field { margin-bottom: 1rem; }
    .lg-field label { display: block; font-size: .8rem; font-weight: 600; color: #555; margin-bottom: 5px; }
    .lg-input { width: 100%; padding: 10px 12px; border: 1px solid #ddd; border-radius: 8px; font-size: .9rem; outline: none; box-sizing: border-box; transition: border .15s; }
    .lg-input:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.15); }
    .lg-btn   { width: 100%; padding: 11px; background: #4f46e5; color: #fff; border: none; border-radius: 8px; font-size: .9rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background .15s; margin-top: .5rem; }
    .lg-btn:hover:not(:disabled) { background: #4338ca; }
    .lg-btn:disabled { background: #a5b4fc; cursor: not-allowed; }
    .lg-spinner { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; }
    .lg-foot  { text-align: center; font-size: .82rem; color: #888; margin-top: 1.25rem; }
    .lg-foot a { color: #4f46e5; font-weight: 600; text-decoration: none; }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
