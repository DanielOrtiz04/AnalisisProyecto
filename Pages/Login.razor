@page "/login"
@inject HttpClient Http
@inject NavigationManager NavManager

<PageTitle>Iniciar Sesion | ReservaCancha</PageTitle>

<h1>Iniciar Sesion</h1>

<div class="card p-4" style="max-width: 450px;">

    <div class="mb-3">
        <label class="form-label"><strong>Correo</strong></label>
        <input class="form-control" type="email" @bind="correo" placeholder="ejemplo@correo.com" />
    </div>

    <div class="mb-3">
        <label class="form-label"><strong>Contrasena</strong></label>
        <input class="form-control" type="password" @bind="password" placeholder="Tu contrasena" />
    </div>

    @if (mensajeError != null)
    {
        <div class="alert alert-danger">@mensajeError</div>
    }

    @if (mensajeExito != null)
    {
        <div class="alert alert-success">@mensajeExito</div>
    }

    <button class="btn btn-primary w-100" @onclick="IniciarSesion">
        Iniciar Sesion
    </button>

    <hr />
    <p class="text-center">No tienes cuenta? <a href="/registro">Registrate aqui</a></p>

</div>

@code {

    private string correo = string.Empty;
    private string password = string.Empty;
    private string? mensajeError;
    private string? mensajeExito;

    private async Task IniciarSesion()
    {
        mensajeError = null;
        mensajeExito = null;

        // RNF-1 Frontend: Validar campos antes de enviar
        if (string.IsNullOrWhiteSpace(correo) || string.IsNullOrWhiteSpace(password))
        {
            mensajeError = "Por favor ingresa tu correo y contrasena.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync(
                "http://localhost:5085/api/usuarios/login",
                new { Correo = correo, Password = password }
            );

            if (response.IsSuccessStatusCode)
            {
                var resultado = await response.Content.ReadFromJsonAsync<LoginRespuesta>();

                // RNF-1 Frontend: Nunca mostrar datos sensibles, solo nombre
                mensajeExito = $"Bienvenido, {resultado?.Nombre}. Redirigiendo...";

                await Task.Delay(1500);

                // RNF-1 Frontend: Redirigir a pagina privada tras login exitoso
                NavManager.NavigateTo($"/perfil/{resultado?.UsuarioId}");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorRespuesta>();
                // RNF-1 Frontend: Mostrar mensaje de intentos restantes o bloqueo
                mensajeError = error?.Mensaje ?? "Correo o contrasena incorrectos.";
            }
            else
            {
                mensajeError = "Ocurrio un error. Intenta de nuevo.";
            }
        }
        catch
        {
            mensajeError = "No se pudo conectar al servidor. Intenta de nuevo.";
        }
    }

    private class LoginRespuesta
    {
        public int UsuarioId { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Mensaje { get; set; } = string.Empty;
    }

    private class ErrorRespuesta
    {
        public string Mensaje { get; set; } = string.Empty;
    }
}