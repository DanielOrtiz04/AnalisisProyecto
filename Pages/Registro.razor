@page "/registro"
@using System.Net.Http.Json
@using ReservaCancha.Services
@inject HttpClient Http
@inject NavigationManager NavManager
@inject SesionService Sesion

<PageTitle>Registro | ReservaCancha</PageTitle>

<div class="rg-wrap">
    <div class="rg-card">
        <div class="rg-logo">⚽</div>
        <h1 class="rg-title">Crear cuenta</h1>
        <p class="rg-sub">Regístrate para reservar canchas</p>

        @if (!string.IsNullOrEmpty(errorMensaje))
        {
            <div class="rg-alert rg-alert--error">@errorMensaje</div>
        }

        <div class="rg-field">
            <label>Nombre completo</label>
            <input type="text" class="rg-input" placeholder="Tu nombre" @bind="nombre" @bind:event="oninput" />
        </div>
        <div class="rg-field">
            <label>Correo electrónico</label>
            <input type="email" class="rg-input" placeholder="correo@ejemplo.com" @bind="correo" @bind:event="oninput" />
        </div>
        <div class="rg-field">
            <label>Teléfono</label>
            <input type="tel" class="rg-input" placeholder="Número de teléfono" @bind="telefono" @bind:event="oninput" />
        </div>
        <div class="rg-field">
            <label>Contraseña</label>
            <input type="password" class="rg-input" placeholder="Mín. 8 caracteres, una mayúscula y un número" @bind="password" @bind:event="oninput" />
        </div>

        <button class="rg-btn" @onclick="Registrar" disabled="@cargando">
            @if (cargando) { <span class="rg-spinner"></span> }
            else { <span>Crear cuenta</span> }
        </button>

        <p class="rg-foot">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
    </div>
</div>

@code {
    private string nombre   = string.Empty;
    private string correo   = string.Empty;
    private string telefono = string.Empty;
    private string password = string.Empty;
    private bool   cargando = false;
    private string? errorMensaje;

    private async Task Registrar()
    {
        errorMensaje = null;
        if (string.IsNullOrWhiteSpace(nombre) || string.IsNullOrWhiteSpace(correo) ||
            string.IsNullOrWhiteSpace(telefono) || string.IsNullOrWhiteSpace(password))
        {
            errorMensaje = "Todos los campos son requeridos.";
            return;
        }
        cargando = true;
        try
        {
            // Paso 1: registrar
            var resp = await Http.PostAsJsonAsync("http://localhost:5085/api/usuarios/registrar",
                new { nombre, correo, telefono, password });

            if (!resp.IsSuccessStatusCode)
            {
                try
                {
                    var err = await resp.Content.ReadFromJsonAsync<ErrResp>();
                    errorMensaje = err?.Mensaje ?? "Error al crear la cuenta.";
                }
                catch { errorMensaje = "Error al crear la cuenta."; }
                return;
            }

            // Paso 2: login automático
            var loginResp = await Http.PostAsJsonAsync("http://localhost:5085/api/usuarios/login",
                new { Correo = correo, Password = password });

            if (loginResp.IsSuccessStatusCode)
            {
                var r = await loginResp.Content.ReadFromJsonAsync<LoginResp>();
                Sesion.IniciarSesion(r!.UsuarioId, r.Nombre, correo.Trim().ToLower());
                NavManager.NavigateTo($"/perfil/{r.UsuarioId}");
            }
            else
            {
                NavManager.NavigateTo("/login");
            }
        }
        catch { errorMensaje = "No se pudo conectar al servidor."; }
        finally { cargando = false; }
    }

    record LoginResp(int UsuarioId, string Nombre, string Mensaje);
    record ErrResp(string Mensaje);
}

<style>
    .rg-wrap  { min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 1rem; }
    .rg-card  { background: #fff; border: 1px solid rgba(0,0,0,.1); border-radius: 16px; padding: 2rem; width: 100%; max-width: 380px; box-shadow: 0 4px 24px rgba(0,0,0,.07); }
    .rg-logo  { font-size: 2.5rem; text-align: center; margin-bottom: .5rem; }
    .rg-title { font-size: 1.4rem; font-weight: 700; text-align: center; margin: 0 0 4px; }
    .rg-sub   { font-size: .85rem; color: #888; text-align: center; margin: 0 0 1.5rem; }
    .rg-alert { padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 1rem; }
    .rg-alert--error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    .rg-field { margin-bottom: 1rem; }
    .rg-field label { display: block; font-size: .8rem; font-weight: 600; color: #555; margin-bottom: 5px; }
    .rg-input { width: 100%; padding: 10px 12px; border: 1px solid #ddd; border-radius: 8px; font-size: .9rem; outline: none; box-sizing: border-box; transition: border .15s; }
    .rg-input:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.15); }
    .rg-btn   { width: 100%; padding: 11px; background: #4f46e5; color: #fff; border: none; border-radius: 8px; font-size: .9rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: .5rem; transition: background .15s; }
    .rg-btn:hover:not(:disabled) { background: #4338ca; }
    .rg-btn:disabled { background: #a5b4fc; cursor: not-allowed; }
    .rg-spinner { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; }
    .rg-foot  { text-align: center; font-size: .82rem; color: #888; margin-top: 1.25rem; }
    .rg-foot a { color: #4f46e5; font-weight: 600; text-decoration: none; }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
