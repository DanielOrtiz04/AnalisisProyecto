@page "/historial"
@using ReservaCancha.Services
@inject NavigationManager NavManager
@inject SesionService Sesion

<PageTitle>Historial | ReservaCancha</PageTitle>

<div class="hr-wrap">
    <div class="hr-header">
        <h1 class="hr-title">Historial de Reservas</h1>
        <p class="hr-sub">Todas tus reservas, pasadas y activas</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMensaje))
    { <div class="hr-alert">@errorMensaje</div> }

    @if (cargando)
    {
        <div class="hr-list">
            @for (int i = 0; i < 4; i++)
            {
                <div class="hr-card hr-card--sk">
                    <div class="sk sk-badge"></div><div class="sk sk-t"></div><div class="sk sk-l"></div><div class="sk sk-l sk-s"></div>
                </div>
            }
        </div>
    }
    else if (reservas.Count == 0)
    {
        <div class="hr-empty">
            <p>No tienes reservas registradas.</p>
            <a href="/canchas" class="hr-link">Ver canchas disponibles</a>
        </div>
    }
    else
    {
        <div class="hr-filters">
            <input class="hr-search" type="text" placeholder="Buscar por cancha o estado…"
                   @bind="filtroTexto" @bind:event="oninput" />
            <input class="hr-date" type="date"
                   value="@filtroFechaStr"
                   @onchange="e => filtroFechaStr = e.Value?.ToString() ?? string.Empty" />
            <button class="hr-clear" @onclick="Limpiar">✕ Limpiar</button>
        </div>

        <div class="hr-list">
            @foreach (var r in Filtradas)
            {
                <div class="hr-card">
                    <div class="hr-top">
                        <span class="hr-badge @(r.Estado == "Confirmada" ? "hr-badge--ok" : "hr-badge--off")">@r.Estado</span>
                        <span class="hr-fecha">@r.Fecha.ToString("dd/MM/yyyy")</span>
                    </div>
                    <h2 class="hr-nombre">Cancha #@r.CanchaId</h2>
                    <p class="hr-horario">🕐 @r.HoraInicio – @r.HoraFin</p>
                </div>
            }
        </div>
        <p class="hr-count">Mostrando <strong>@Filtradas.Count</strong> de <strong>@reservas.Count</strong></p>
    }
</div>

@code {
    private List<ReservaVista> reservas = new();
    private bool cargando = true;
    private string? errorMensaje;
    private string filtroTexto = string.Empty;
    private string filtroFechaStr = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.Autenticado) { NavManager.NavigateTo("/login"); return; }
        try
        {
            using var http = new System.Net.Http.HttpClient();
            var r = await http.GetFromJsonAsync<ApiResp>($"http://localhost:5085/api/reservas/usuario/{Sesion.UsuarioId}");
            reservas = r?.Data ?? new();
        }
        catch { errorMensaje = "No se pudieron cargar las reservas."; }
        finally { cargando = false; }
    }

    private List<ReservaVista> Filtradas => reservas.Where(r =>
        (string.IsNullOrWhiteSpace(filtroTexto) ||
         r.CanchaId.ToString().Contains(filtroTexto) ||
         r.Estado.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase))
        &&
        (string.IsNullOrEmpty(filtroFechaStr) ||
         !DateTime.TryParse(filtroFechaStr, out var fd) ||
         r.Fecha.Date == fd.Date)
    ).ToList();

    private void Limpiar() { filtroTexto = string.Empty; filtroFechaStr = string.Empty; }

    class ApiResp { public List<ReservaVista> Data { get; set; } = new(); }
    public class ReservaVista
    {
        public int Id { get; set; }
        public int CanchaId { get; set; }
        public DateTime Fecha { get; set; }
        public string HoraInicio { get; set; } = string.Empty;
        public string HoraFin { get; set; } = string.Empty;
        public string Estado { get; set; } = string.Empty;
    }
}

<style>
    .hr-wrap  { max-width: 650px; margin: 2rem auto; padding: 0 1.25rem; font-family: Segoe UI, sans-serif; }
    .hr-header { margin-bottom: 1.5rem; }
    .hr-title { font-size: 1.6rem; font-weight: 700; margin: 0 0 4px; }
    .hr-sub   { font-size: .875rem; color: #6b7280; margin: 0; }
    .hr-alert { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; padding: 10px 14px; border-radius: 8px; margin-bottom: 1rem; font-size: 13px; }
    .hr-empty { text-align: center; padding: 3rem; color: #9ca3af; }
    .hr-link  { color: #6366f1; font-weight: 600; text-decoration: none; font-size: .875rem; }
    .hr-filters { display: flex; gap: .6rem; flex-wrap: wrap; margin-bottom: 1.25rem; align-items: center; }
    .hr-search { flex: 1; min-width: 160px; padding: 9px 12px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: .875rem; outline: none; }
    .hr-date  { padding: 9px 12px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: .875rem; outline: none; }
    .hr-clear { padding: 9px 14px; background: #f1f5f9; color: #64748b; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; }
    .hr-list  { display: flex; flex-direction: column; gap: 1rem; }
    .hr-card  { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 1.1rem 1.25rem; box-shadow: 0 1px 4px rgba(0,0,0,.05); }
    .hr-top   { display: flex; justify-content: space-between; align-items: center; margin-bottom: .4rem; }
    .hr-badge { font-size: .72rem; font-weight: 700; padding: 3px 10px; border-radius: 20px; }
    .hr-badge--ok  { background: #dcfce7; color: #166534; }
    .hr-badge--off { background: #f1f5f9; color: #64748b; }
    .hr-fecha { font-size: .8rem; color: #9ca3af; }
    .hr-nombre { font-size: 1rem; font-weight: 700; margin: 0 0 2px; color: #111827; }
    .hr-horario { font-size: .875rem; color: #6b7280; margin: 0; }
    .hr-count { text-align: right; font-size: .78rem; color: #9ca3af; margin-top: .75rem; }
    .hr-card--sk { pointer-events: none; }
    .sk { border-radius: 6px; margin-bottom: 8px; background: linear-gradient(90deg,#f0f0f0 25%,#e0e0e0 50%,#f0f0f0 75%); background-size: 200% 100%; animation: shimmer 1.4s ease-in-out infinite; }
    .sk-badge { height: 20px; width: 80px; border-radius: 20px; } .sk-t { height: 16px; width: 50%; } .sk-l { height: 12px; width: 70%; } .sk-s { width: 40%; }
    @@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
</style>
