@page "/canchas"
@using ReservaCancha.Models
@inject NavigationManager NavManager
@inject HttpClient Http

<PageTitle>Canchas | ReservaCancha</PageTitle>

<h1>Canchas disponibles</h1>

<h3>
    @(nuevaCancha.Id == 0 ? "Agregar cancha" : "Editar cancha")
</h3>

<EditForm Model="nuevaCancha"
          OnValidSubmit="GuardarCancha">

    <div class="mb-2">
        <InputText class="form-control"
                   placeholder="Nombre"
                   @bind-Value="nuevaCancha.Nombre" />
    </div>

    <div class="mb-2">
        <InputText class="form-control"
                   placeholder="Tipo"
                   @bind-Value="nuevaCancha.Tipo" />
    </div>

    <div class="mb-2">
        <InputText class="form-control"
                   placeholder="Descripción"
                   @bind-Value="nuevaCancha.Descripcion" />
    </div>

    <div class="mb-2">
        <InputNumber class="form-control"
                     placeholder="Precio"
                     @bind-Value="nuevaCancha.Precio" />
    </div>

    <div class="form-check mb-3">
        <InputCheckbox class="form-check-input"
                       @bind-Value="nuevaCancha.Disponible" />

        <label class="form-check-label">
            Disponible
        </label>
    </div>

    <button type="submit"
            class="btn btn-primary">

        Guardar

    </button>

</EditForm>

<hr />

@if (cargando)
{
    <p>Cargando canchas...</p>
}
else if (errorMensaje != null)
{
    <div class="alert alert-danger">
        @errorMensaje
    </div>
}
else if (canchas.Count == 0)
{
    <p>No hay canchas disponibles.</p>
}
else
{
    @foreach (var cancha in canchas)
    {
        <div class="card mb-3 p-3">

            <h4>@cancha.Nombre</h4>

            <p>
                <strong>Tipo:</strong>
                @cancha.Tipo
            </p>

            <p>
                <strong>Descripción:</strong>
                @cancha.Descripcion
            </p>

            <p>
                <strong>Precio:</strong>
                Q.@cancha.Precio
            </p>

            <p>
                <strong>Estado:</strong>
                @(cancha.Disponible ? "Disponible" : "No disponible")
            </p>

            <div class="d-flex gap-2">

                <button class="btn btn-success"
                        @onclick="() => Reservar(cancha.Id)">
                    Reservar
                </button>

                <button class="btn btn-warning"
                        @onclick="() => Editar(cancha)">
                    Editar
                </button>

                <button class="btn btn-danger"
                        @onclick="() => Eliminar(cancha.Id)">
                    Eliminar
                </button>

            </div>

        </div>
    }
}

@code {

    private List<Cancha> canchas = new();

    private Cancha nuevaCancha = new();

    private bool cargando = true;

    private string? errorMensaje;

    protected override async Task OnInitializedAsync()
    {
        await ObtenerCanchas();
    }

    private async Task ObtenerCanchas()
    {
        cargando = true;
        errorMensaje = null;

        try
        {
            var resultado = await Http.GetFromJsonAsync<List<Cancha>>(
                "http://localhost:5085/api/canchas"
            );

            canchas = resultado ?? new();
        }
        catch
        {
            errorMensaje =
                "No se pudieron cargar las canchas.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarCancha()
    {
        if (nuevaCancha.Id == 0)
        {
            await Http.PostAsJsonAsync(
                "http://localhost:5085/api/canchas",
                nuevaCancha
            );
        }
        else
        {
            await Http.PutAsJsonAsync(
                $"http://localhost:5085/api/canchas/{nuevaCancha.Id}",
                nuevaCancha
            );
        }

        nuevaCancha = new();

        await ObtenerCanchas();
    }

    private void Editar(Cancha cancha)
    {
        nuevaCancha = new Cancha
        {
            Id = cancha.Id,
            Nombre = cancha.Nombre,
            Tipo = cancha.Tipo,
            Descripcion = cancha.Descripcion,
            Precio = cancha.Precio,
            Disponible = cancha.Disponible
        };
    }

    private async Task Eliminar(int id)
    {
        await Http.DeleteAsync(
            $"http://localhost:5085/api/canchas/{id}"
        );

        await ObtenerCanchas();
    }

    private void Reservar(int canchaId)
    {
        NavManager.NavigateTo($"/reservar/{canchaId}");
    }
}