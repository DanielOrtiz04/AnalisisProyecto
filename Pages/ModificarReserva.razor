@page "/modificar-reserva/{Id:int}"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavManager

<PageTitle>Modificar Reserva</PageTitle>

<div class="mr-wrap">
    <div class="mr-header">
        <h1>Modificar Reserva</h1>
        <p>Cambia la fecha o el horario de tu reserva.</p>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="mr-alert-success">@mensaje</div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="mr-alert-error">@error</div>
    }

    @if (cargando)
    {
        <p>Cargando reserva...</p>
    }
    else
    {
        <div class="mr-form">
            <div class="mr-group">
                <label>Nueva Fecha</label>
                <input type="date" class="mr-input"
                       value="@fechaString"
                       @onchange="e => fechaString = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="mr-group">
                <label>Hora Inicio</label>
                <input type="time" class="mr-input"
                       value="@horaInicioString"
                       @onchange="e => horaInicioString = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="mr-group">
                <label>Hora Fin</label>
                <input type="time" class="mr-input"
                       value="@horaFinString"
                       @onchange="e => horaFinString = e.Value?.ToString() ?? string.Empty" />
            </div>
            <button class="mr-btn" @onclick="GuardarCambios" disabled="@guardando">
                @if (guardando) { <span>Guardando...</span> }
                else { <span>Guardar Cambios</span> }
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private bool    cargando         = true;
    private bool    guardando        = false;
    private string? mensaje;
    private string? error;
    private string  fechaString      = string.Empty;
    private string  horaInicioString = string.Empty;
    private string  horaFinString    = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var reserva = await Http.GetFromJsonAsync<ReservaDto>(
                $"http://localhost:5085/api/reservas/{Id}");

            if (reserva != null)
            {
                fechaString      = reserva.Fecha.ToString("yyyy-MM-dd");
                horaInicioString = reserva.HoraInicio;
                horaFinString    = reserva.HoraFin;
            }
        }
        catch
        {
            error = "No se pudo cargar la reserva.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarCambios()
    {
        guardando = true;
        mensaje   = null;
        error     = null;

        if (!DateTime.TryParse(fechaString, out var fecha) ||
            !TimeSpan.TryParse(horaInicioString, out var horaInicio) ||
            !TimeSpan.TryParse(horaFinString, out var horaFin))
        {
            error     = "Verifica que la fecha y los horarios sean válidos.";
            guardando = false;
            return;
        }

        try
        {
            var request  = new { Fecha = fecha, HoraInicio = horaInicio, HoraFin = horaFin };
            var response = await Http.PatchAsJsonAsync(
                $"http://localhost:5085/api/reservas/{Id}/modificar", request);

            if (response.IsSuccessStatusCode)
            {
                mensaje = "Reserva modificada exitosamente.";
                await Task.Delay(1500);
                NavManager.NavigateTo("/historial");
            }
            else
            {
                error = "No se pudo modificar la reserva.";
            }
        }
        catch
        {
            error = "Error de conexión con el servidor.";
        }
        finally
        {
            guardando = false;
        }
    }

    public class ReservaDto
    {
        public int      Id         { get; set; }
        public DateTime Fecha      { get; set; }
        public string   HoraInicio { get; set; } = string.Empty;
        public string   HoraFin    { get; set; } = string.Empty;
    }
}

<style>
    .mr-wrap { max-width: 500px; margin: 2rem auto; padding: 1rem; font-family: Segoe UI, sans-serif; }
    .mr-header h1 { font-size: 24px; margin-bottom: 6px; }
    .mr-header p  { color: #666; margin-bottom: 1.5rem; }
    .mr-form  { display: flex; flex-direction: column; gap: 1rem; }
    .mr-group { display: flex; flex-direction: column; gap: 6px; }
    .mr-input { padding: 10px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; }
    .mr-btn   { background: #185FA5; color: white; border: none; padding: 12px; border-radius: 8px; cursor: pointer; font-weight: 600; }
    .mr-btn:hover    { background: #144d87; }
    .mr-btn:disabled { opacity: .6; cursor: not-allowed; }
    .mr-alert-success { background: #EAF3DE; color: #3B6D11; padding: 10px; border-radius: 8px; margin-bottom: 1rem; }
    .mr-alert-error   { background: #FCEBEB; color: #A32D2D; padding: 10px; border-radius: 8px; margin-bottom: 1rem; }
</style>
