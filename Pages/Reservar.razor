@page "/reservar/{CanchaId:int}"
@using ReservaCancha.Models
@using ReservaCancha.Services
@inject NavigationManager NavManager
@inject SesionService Sesion

<PageTitle>Reservar cancha | ReservaCancha</PageTitle>

<div class="rv-wrap">
    <div class="rv-header">
        <button class="rv-back" @onclick="Volver">&#8592; Volver</button>
        <h1 class="rv-title">Reservar cancha</h1>
        <p class="rv-sub">Selecciona la fecha y horario disponible</p>
    </div>

    @if (reservaExitosa)
    {
        <div class="rv-toast rv-toast--ok">✅ Reserva confirmada. ¡Te esperamos!</div>
    }
    @if (!string.IsNullOrEmpty(errorMensaje))
    {
        <div class="rv-toast rv-toast--err">@errorMensaje</div>
    }

    <div class="rv-card">
        <div class="rv-field">
            <label>Cancha seleccionada</label>
            <div class="rv-tag">📍 Cancha #@CanchaId</div>
        </div>
        <div class="rv-field">
            <label>Fecha de reserva</label>
            <input type="date" class="rv-input"
                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                   value="@fechaStr"
                   @onchange="e => fechaStr = e.Value?.ToString() ?? string.Empty" />
            @if (mostrarErr && string.IsNullOrEmpty(fechaStr))
            { <p class="rv-err">Selecciona una fecha.</p> }
        </div>
        <div class="rv-row">
            <div class="rv-field">
                <label>Hora de inicio</label>
                <input type="time" class="rv-input"
                       value="@horaInicioStr"
                       @onchange="e => horaInicioStr = e.Value?.ToString() ?? string.Empty" />
                @if (mostrarErr && string.IsNullOrEmpty(horaInicioStr))
                { <p class="rv-err">Requerido.</p> }
            </div>
            <div class="rv-field">
                <label>Hora de fin</label>
                <input type="time" class="rv-input"
                       value="@horaFinStr"
                       @onchange="e => horaFinStr = e.Value?.ToString() ?? string.Empty" />
                @if (mostrarErr && string.IsNullOrEmpty(horaFinStr))
                { <p class="rv-err">Requerido.</p> }
            </div>
        </div>
        <button class="rv-btn" @onclick="EnviarReserva" disabled="@cargando">
            @if (cargando) { <span class="rv-spinner"></span> }
            else { <span>Confirmar reserva</span> }
        </button>
    </div>
</div>

@code {
    [Parameter] public int CanchaId { get; set; }

    private string  fechaStr       = string.Empty;
    private string  horaInicioStr  = string.Empty;
    private string  horaFinStr     = string.Empty;
    private bool    cargando       = false;
    private bool    reservaExitosa = false;
    private bool    mostrarErr     = false;
    private string? errorMensaje;

    protected override void OnInitialized()
    {
        if (!Sesion.Autenticado) NavManager.NavigateTo("/login");
    }

    private async Task EnviarReserva()
    {
        mostrarErr = true; errorMensaje = null; reservaExitosa = false;

        if (string.IsNullOrEmpty(fechaStr) || string.IsNullOrEmpty(horaInicioStr) || string.IsNullOrEmpty(horaFinStr))
            return;
        if (!DateTime.TryParse(fechaStr, out var fecha)) { errorMensaje = "Fecha inválida."; return; }
        if (!TimeSpan.TryParse(horaInicioStr, out var hi) || !TimeSpan.TryParse(horaFinStr, out var hf))
        { errorMensaje = "Hora inválida."; return; }
        if (hf <= hi) { errorMensaje = "La hora de fin debe ser mayor a la de inicio."; return; }

        cargando = true;
        try
        {
            using var http = new System.Net.Http.HttpClient();
            var payload = new
            {
                canchaId   = CanchaId,
                usuarioId  = Sesion.UsuarioId,   // usa el usuario logueado
                fecha      = fecha.ToString("yyyy-MM-dd"),
                horaInicio = hi.ToString(@"hh\:mm\:ss"),
                horaFin    = hf.ToString(@"hh\:mm\:ss")
            };
            var resp = await http.PostAsJsonAsync("http://localhost:5085/api/reservas", payload);

            if (resp.IsSuccessStatusCode)
            {
                reservaExitosa = true;
                fechaStr = horaInicioStr = horaFinStr = string.Empty;
                mostrarErr = false;
            }
            else if (resp.StatusCode == System.Net.HttpStatusCode.Conflict)
                errorMensaje = "Ese horario ya está reservado. Elige otro.";
            else
                errorMensaje = "Ocurrió un error. Intenta de nuevo.";
        }
        catch { errorMensaje = "No se pudo conectar al servidor."; }
        finally { cargando = false; }
    }

    private void Volver() => NavManager.NavigateTo("/canchas");
}

<style>
    .rv-wrap  { max-width: 480px; margin: 2rem auto; padding: 0 1rem; font-family: Segoe UI, sans-serif; }
    .rv-header { margin-bottom: 1.5rem; }
    .rv-back  { background: none; border: none; color: #6366f1; font-size: 14px; cursor: pointer; padding: 0; margin-bottom: 8px; font-weight: 500; }
    .rv-back:hover { text-decoration: underline; }
    .rv-title { font-size: 1.4rem; font-weight: 700; margin: 0 0 4px; }
    .rv-sub   { font-size: .85rem; color: #6b7280; margin: 0; }
    .rv-toast { padding: 10px 14px; border-radius: 10px; font-size: 13px; margin-bottom: 1rem; }
    .rv-toast--ok  { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .rv-toast--err { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    .rv-card  { background: #fff; border: 1px solid #e5e7eb; border-radius: 16px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
    .rv-field { margin-bottom: 1rem; }
    .rv-field label { display: block; font-size: .8rem; font-weight: 600; color: #374151; margin-bottom: 6px; }
    .rv-input { width: 100%; padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: .9rem; outline: none; box-sizing: border-box; }
    .rv-input:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.15); }
    .rv-err   { font-size: .75rem; color: #dc2626; margin-top: 4px; }
    .rv-tag   { padding: 9px 12px; background: #eef2ff; border-radius: 8px; font-size: .875rem; font-weight: 600; color: #4f46e5; }
    .rv-row   { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .rv-btn   { width: 100%; padding: 11px; font-size: .9rem; font-weight: 600; background: #4f46e5; color: #fff; border: none; border-radius: 10px; cursor: pointer; margin-top: .5rem; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background .15s; }
    .rv-btn:hover:not(:disabled) { background: #4338ca; }
    .rv-btn:disabled { background: #a5b4fc; cursor: not-allowed; }
    .rv-spinner { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: spin .7s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
